{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "backend.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "gfw-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "gfw-monitor",
        "run",
        "uvicorn",
        "server.main:app",
        "--reload",
        "--port",
        "8010"
      ],
      "port": 8010
    },
    {
      "name": "gfw-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "gfw-monitor/web",
        "run",
        "dev"
      ],
      "port": 5190
    },
    {
      "name": "sar-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "sar-monitor",
        "run",
        "uvicorn",
        "server.main:app",
        "--reload",
        "--port",
        "8020"
      ],
      "port": 8020
    },
    {
      "name": "sar-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "sar-monitor/web",
        "run",
        "dev"
      ],
      "port": 5200
    }
  ]
}
