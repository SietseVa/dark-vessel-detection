# Settings and credentials for the hackathon notebooks

# --- Copernicus Data Space (Sentinel-1). Create an OAuth client at:
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Sentinel-1 download
S1_DATA_DIR=data/sentinel1
# name:lon_min,lat_min,lon_max,lat_max ; separate areas with ;
S1_AREAS=rotterdam:3.55,51.92,3.95,52.12;ijmuiden:4.15,52.38,4.55,52.55
S1_LOOKBACK_DAYS=10
S1_MAX_PASSES=1
S1_MIN_COVERAGE=0.5

# --- Tiling: reuses the exact scaling of the training tiles
TILE_OVERLAP=64

# --- Global Fishing Watch
GFW_TOKEN=
# hours of AIS before and after each pass, and extra margin around each area
GFW_WINDOW_HOURS=2
GFW_MARGIN_KM=10
# also fetch GFW's own radar detections (matched/unmatched) for each pass, as a reference
GFW_WITH_SAR=false

# --- aisstream.io (live AIS recorder). Get a key at https://aisstream.io
AISSTREAM_API_KEY=
